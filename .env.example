# Copy via scripts/setup_local.py; never put server secrets in VITE_* variables.
APP_ENV=development
API_ORIGIN=http://localhost:8010
FRONTEND_ORIGIN=http://localhost:5173
SQLITE_PATH=data/dashboard.sqlite3
JWT_SECRET=
CSRF_SECRET=
ROTATION_SECRET=
JWT_ISSUER=economic-indicators-api
JWT_AUDIENCE=economic-indicators-dashboard
SESSION_MAX_AGE_SECONDS=604800
REFRESH_SETTLE_SECONDS=30
COLLECTOR_ENABLED=true
GDP_COLLECTION_INTERVAL_SECONDS=604800
# A rolling input window includes a comparison year. Optional fixed overrides:
GDP_COLLECTION_YEARS=12
GDP_START_YEAR=
GDP_END_YEAR=
GDP_REPORT_YEARS=5
UPSTREAM_TIMEOUT_SECONDS=20
UPSTREAM_ATTEMPTS=2
CGA_COLLECTION_INTERVAL_SECONDS=86400
GST_COLLECTION_INTERVAL_SECONDS=86400
TRADE_COLLECTION_INTERVAL_SECONDS=86400
CPI_COLLECTION_INTERVAL_SECONDS=86400
POLICY_COLLECTION_INTERVAL_SECONDS=604800
DEBT_COLLECTION_INTERVAL_SECONDS=604800
# Official appendix must match the Data360 mirror vintage; new releases require review.
DEBT_APPENDIX_URL=https://data.imf.org/-/media/iData/External-Storage/Documents/C4182C5C54794FC48892DE8F6C74FF82/en/October-2026-WEO-Database-Appendix.pdf
INFLATION_POLICY_URL=https://egazette.gov.in/WriteReadData/2026/271285.pdf
COLLECTION_JOB_BUDGET_SECONDS=600
MACRO_REPORT_YEARS=5
# Omit COLLECTION_GROUPS to supervise every implemented non-GDP group.
# Set an explicit comma-separated list to restrict it (empty disables these groups).
# COLLECTION_GROUPS=expenditure
# Optional verified historical Commerce PIB references, separated with |:
# TRADE_HISTORY_URLS=https://www.pib.gov.in/PressReleasePage.aspx?PRID=1916220&reg=48&lang=2|https://www.pib.gov.in/PressReleasePage.aspx?PRID=2017942&reg=48&lang=2
# Production also requires COOKIE_SITE_DOMAIN (the controlled parent domain).

# Production entry app.serve additionally requires (never use these for the local command):
# PERSISTENT_DATA_DIR=/var/data
# SQLITE_PATH=/var/data/private/dashboard.sqlite3
# TRUSTED_PROXY_CIDRS=<reviewed actual ingress IPs/CIDRs, comma separated; no wildcard>
# API_ORIGIN=https://api.<controlled-domain>
# FRONTEND_ORIGIN=https://dashboard.<controlled-domain>
# COOKIE_SITE_DOMAIN=<controlled-domain>
# Frontend build values are configured separately in Pages; see docs/deployment.md.
